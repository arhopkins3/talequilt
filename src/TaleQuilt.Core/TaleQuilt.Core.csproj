<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Referenced by the API and worker images; the lock file must carry the same linux-x64 targets they publish with. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <!-- Domain model and data access shared by the API and the worker. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Direct reference only to lift a vulnerable transitive version; see Directory.Packages.props. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TaleQuilt.Core.Tests" />
  </ItemGroup>
</Project>
